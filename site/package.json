{
  "name": "sempre-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "tsc": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:ui": "tsx scripts/capture-control-plane.ts",
    "capture:home": "tsx scripts/capture-home.ts"
  },
  "dependencies": {
    "lucide": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "globals": "latest",
    "sharp": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "tsx": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
